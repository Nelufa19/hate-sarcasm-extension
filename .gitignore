backend/.venv/
__pycache__/
*.pyc
.env
*.log
.DS_Store

# User corrections. Useful as training data, but it accumulates a trace of
# whatever pages were browsed while the extension was on, so it should never be
# committed or shared by accident. Export it deliberately when you want it.
backend/data/

# Fine-tuned checkpoints produced by the automatic retrain pipeline. Every run
# writes a full ~500 MB model.pt (rejected candidates included, deliberately --
# they stay inspectable), so this directory grows fast and must never be
# committed.
backend/models/retrained/

# Base checkpoints exceed GitHub's 100MB file limit; fetch them separately
# (see SETUP.md) rather than committing them.
backend/models/Lightweight Bangla/model.pt
backend/models/Lightweight English/model.pt
